<Window
    x:Class="MessengerService.Windows.AlertBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MessengerService.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Alert!"
    Width="300"
    Height="100"
    mc:Ignorable="d">
    <Grid Name="MainGrid">
        <Label Name="TextForLabel" />
        <Button
            Name="BtnYes"
            Click="BtnYes_Click"
            Content="Yes" />
        <Button
            Name="BtnNo"
            Click="BtnNo_Click"
            Content="No" />
        <Button
            Name="BtnCancel"
            Click="BtnCancel_Click"
            Content="Cancel" />
    </Grid>
</Window>
