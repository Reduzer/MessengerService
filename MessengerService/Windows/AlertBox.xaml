<Window
    x:Class="MessengerService.Windows.AlertBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MessengerService.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Alert!"
    Width="300"
    Height="100"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="/Windows/Components/MergedDictionary.xaml" />
    </Window.Resources>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Label
            Name="TextForLabel"
            Grid.Row="0"
            Style="{DynamicResource LabelAlertStyle}" />

        <Button
            Name="BtnYes"
            Grid.Row="1"
            Margin="100,5,100,5"
            Padding="0"
            Click="BtnYes_Click"
            Content="Yes"
            Style="{DynamicResource ButtonAlertStyle}" />

        <Button
            Name="BtnNo"
            Grid.Row="1"
            Margin="5,5,220,5"
            Padding="0"
            Click="BtnNo_Click"
            Content="No"
            Style="{DynamicResource ButtonAlertStyle}" />

        <Button
            Name="BtnCancel"
            Grid.Row="1"
            Margin="220,5,5,5"
            Padding="0"
            Click="BtnCancel_Click"
            Content="Cancel"
            Style="{DynamicResource ButtonAlertStyle}" />
    </Grid>
</Window>
