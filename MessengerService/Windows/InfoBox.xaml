<Window
    x:Class="MessengerService.Windows.InfoBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MessengerService.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InfoBox"
    Width="300"
    Height="100"
    Background="#404040"
    Foreground="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="Components/InfoBox/MergedDictonary.xaml" />
    </Window.Resources>
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="49*" />
            <ColumnDefinition Width="251*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label
            Name="TextForLabel"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Foreground="White"
            Style="{DynamicResource LabelStyle2}" />

        <Button
            Name="BtnOk"
            Grid.Row="1"
            Grid.Column="1"
            Margin="51,5,100,5"
            Padding="0"
            Click="BtnOk_OnClick"
            Content="Ok"
            Style="{DynamicResource ButtonStyle2}"
            Visibility="Visible" />
    </Grid>
</Window>
