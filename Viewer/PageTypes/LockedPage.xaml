<Page
    x:Class="Viewer.PageTypes.LockedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Viewer.PageTypes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LockedPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Offset="0.05" Color="Black" />
                <GradientStop Offset="0.1" Color="DarkOrange" />
                <GradientStop Offset="0.2" Color="Black" />
                <GradientStop Offset="0.3" Color="DarkOrange" />
                <GradientStop Offset="0.4" Color="Black" />
                <GradientStop Offset="0.5" Color="DarkOrange" />
                <GradientStop Offset="0.6" Color="Black" />
                <GradientStop Offset="0.7" Color="DarkOrange" />
                <GradientStop Offset="0.8" Color="Black" />
                <GradientStop Offset="0.9" Color="DarkOrange" />
                <GradientStop Offset="0.95" Color="Black" />
            </LinearGradientBrush>
        </Grid.Background>
    </Grid>
</Page>
