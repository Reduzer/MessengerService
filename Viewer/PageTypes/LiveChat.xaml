<Page
    x:Class="Viewer.PageTypes.LiveChat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Viewer.PageTypes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LiveChat"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary Source="..\Components\LiveChat\MergedLiveChat.xaml" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="InputBox"
            Grid.Row="1"
            Style="{DynamicResource TextBoxStyle}" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Frame Name="ChatFrame" Grid.Column="1">
                <Frame.Content>
                    <ScrollViewer
                        Name="SendViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <WrapPanel
                            Name="MessagesSendWrapPannel"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical"
                            Style="{DynamicResource WrapPanelStyle1}" />
                    </ScrollViewer>
                </Frame.Content>
            </Frame>

            <Frame Name="RecievedFrame" Grid.Column="0">
                <Frame.Content>
                    <ScrollViewer
                        Name="RecievedViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <WrapPanel
                            Name="MessagesRecievedWrapPannel"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical"
                            Style="{DynamicResource WrapPanelStyle1}" />

                    </ScrollViewer>
                </Frame.Content>
            </Frame>
        </Grid>


    </Grid>
</Page>
