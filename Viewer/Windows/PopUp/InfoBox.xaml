<Window
    x:Class="Viewer.Windows.InfoBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Viewer.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="InfoBox"
    Width="300"
    Height="100"
    Background="#404040"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary Source="../Components/InfoBox/MergedDictonary.xaml" />
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label
            Name="InfoText"
            Grid.Row="0"
            Padding="0"
            Style="{DynamicResource Label}" />

        <Button
            Name="BTN_OK"
            Grid.Row="1"
            Margin="10,10"
            Click="BTN_OK_Click"
            Style="{DynamicResource Button}" />
    </Grid>
</Window>
